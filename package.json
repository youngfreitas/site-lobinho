{
  "name": "lobinho-passeios",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Homepage da Lobinho Passeios de Lancha — Ubatuba, SP",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "media": "node scripts/optimize-media.mjs",
    "dev": "npm run tokens && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
